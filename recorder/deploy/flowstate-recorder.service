# systemd service for the FlowState Betfair recorder.
# Installed by setup.sh to /etc/systemd/system/flowstate-recorder.service.
[Unit]
Description=FlowState Betfair recorder (paper only, never places bets)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=recorder
Group=recorder
WorkingDirectory=/opt/flowstate/recorder
EnvironmentFile=/etc/flowstate-recorder.env
ExecStart=/opt/flowstate/recorder/node_modules/.bin/tsx src/main.ts
# Restart on any exit, forever, 10 seconds apart
Restart=always
RestartSec=10
StartLimitIntervalSec=0
# Pending writes are kept here across restarts
StateDirectory=flowstate-recorder
Environment=SPOOL_DIR=/var/lib/flowstate-recorder
# Lock it down: it only needs the network and its own state folder
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=450M

[Install]
WantedBy=multi-user.target
