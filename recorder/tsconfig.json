{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "paths": { "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"] }
  },
  "include": ["src/**/*.ts", "../lib/betfair/run.ts", "../lib/betfair/stratRun.ts", "../lib/betfair/recorder.ts"]
}
